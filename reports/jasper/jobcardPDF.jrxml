	<subDataset  name="TyreInventoryDataset" >
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Bodyshop PostgreSQL"/>
		<parameter name="JOBCARD_ID" class="java.lang.Long">
			<defaultValueExpression><![CDATA[$P{JOBCARD_ID}]]></defaultValueExpression>
		</parameter>
		<queryString  language="SQL"><![CDATA[SELECT
    position,
    make,
    size,
    depth,
    wheel_cap
FROM core_jobcardtyreinventory
WHERE job_id = $P{JOBCARD_ID}
ORDER BY id]]></queryString >
		<field name="position" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="position"/>
			<property name="com.jaspersoft.studio.field.label" value="position"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="core_jobcardtyreinventory"/>
		</field>
		<field name="make" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="make"/>
			<property name="com.jaspersoft.studio.field.label" value="make"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="core_jobcardtyreinventory"/>
		</field>
		<field name="size" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="size"/>
			<property name="com.jaspersoft.studio.field.label" value="size"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="core_jobcardtyreinventory"/>
		</field>
		<field name="depth" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="depth"/>
			<property name="com.jaspersoft.studio.field.label" value="depth"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="core_jobcardtyreinventory"/>
		</field>
		<field name="wheel_cap" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="wheel_cap"/>
			<property name="com.jaspersoft.studio.field.label" value="wheel_cap"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="core_jobcardtyreinventory"/>
		</field>
	</subDataset >
	<subDataset  name="inventory" >
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Bodyshop PostgreSQL"/>
		<parameter name="JOBCARD_ID" class="java.lang.Long">
			<defaultValueExpression><![CDATA[$P{JOBCARD_ID}]]></defaultValueExpression>
		</parameter>
		<queryString  language="SQL"><![CDATA[SELECT 'Jack' AS item, CASE WHEN jack THEN 'Yes' ELSE 'No' END AS value
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Tools', CASE WHEN tool_kit THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Mud Flap', COALESCE(CAST(mud_flap_count AS VARCHAR), '0')
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Floor Mat', COALESCE(CAST(floor_mat_count AS VARCHAR), '0')
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'RH Mirror', CASE WHEN rh_mirror THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'LH Mirror', CASE WHEN lh_mirror THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Center Mirror', CASE WHEN center_mirror THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Battery', CASE WHEN battery THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Stereo', CASE WHEN stereo THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Front Wiper', CASE WHEN frt_wiper THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Rear Wiper', CASE WHEN rr_wiper THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}

UNION ALL
SELECT 'Accessories', CASE WHEN accessories THEN 'Yes' ELSE 'No' END
FROM core_jobcardinventory WHERE job_id = $P{JOBCARD_ID}]]></queryString >
		<field name="item" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="item"/>
			<property name="com.jaspersoft.studio.field.label" value="item"/>
		</field>
		<field name="value" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="value"/>
			<property name="com.jaspersoft.studio.field.label" value="value"/>
		</field>
	</subDataset >
	<parameter name="JOBCARD_ID" class="java.lang.Long">
		<defaultValueExpression><![CDATA[$P{JOBCARD_ID}]]></defaultValueExpression>
	</parameter>
	<queryString  language="SQL"><![CDATA[SELECT
    j.id AS jobcard_id,
    j.job_no AS jobcard_no,
    j.job_date,
    j.km,
    j.jobcard_type,
    v.registration_no,
    m.name,
    vv.name,
    v.color,
    c.name AS customer_name,
    c.mobile_no,
    c.email,
    c.address,
    cl.claim_no
FROM core_jobcard j
LEFT JOIN core_claim cl ON j.claim_id = cl.id
LEFT JOIN core_vehicle v ON cl.vehicle_id = v.id
LEFT JOIN core_customer c ON v.customer_id = c.id
LEFT JOIN core_vehiclemodel m ON v.model_id = m.id
LEFT JOIN core_vehiclevariant vv ON v.variant_id = vv.id
WHERE j.id = 1]]></queryString>
