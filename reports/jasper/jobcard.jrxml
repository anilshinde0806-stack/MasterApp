	<parameter name="JOBCARD_ID" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    j.id AS jobcard_id,
    j.job_no AS jobcard_no,
    j.job_date,
    j.km,
    j.jobcard_type,
    v.registration_no,
    m.name,
    vv.name,
    v.color,
    c.name AS customer_name,
    c.mobile_no,
    c.email,
    c.address,
    cl.claim_no
FROM core_jobcard j
LEFT JOIN core_claim cl ON j.claim_id = cl.id
LEFT JOIN core_vehicle v ON cl.vehicle_id = v.id
LEFT JOIN core_customer c ON v.customer_id = c.id
LEFT JOIN core_vehiclemodel m ON v.model_id = m.id
LEFT JOIN core_vehiclevariant vv ON v.variant_id = vv.id
WHERE j.id = $P{JOBCARD_ID}]]>
	</queryString>
